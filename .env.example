# Copy to .env and fill in. NEVER commit .env (it is git-ignored). All values are placeholders.

# --- General -------------------------------------------------------------------------------
# prod: strict (https issuer, no OpenAPI docs). dev: local development.
ENVIRONMENT=prod

# --- Session / security --------------------------------------------------------------------
# REQUIRED. Random, >= 32 bytes. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Secure cookies need HTTPS. For plain-http local development only (localhost counts as secure
# in modern browsers, so you normally do not need to change this): COOKIE_SECURE=false
COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
# Comma-separated Host headers the app accepts, e.g. labels.example.com
ALLOWED_HOSTS=*
# Send HSTS (only behind TLS)
HSTS_ENABLED=true
# Address(es) of your reverse proxy whose X-Forwarded-* headers are trusted
FORWARDED_ALLOW_IPS=127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SUBMIT=120/minute
RATE_LIMIT_READ=240/minute

# --- OIDC (authorization code flow + PKCE S256; any provider) -----------------------------------
# Authentik: https://auth.example.com/application/o/<application-slug>/
# Keycloak:  https://sso.example.com/realms/<realm>
# Google:    https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match the redirect URI registered at the provider exactly
OIDC_REDIRECT_URI=https://labels.example.com/auth/callback
# Optional extra allowed redirect URIs (comma separated); OIDC_REDIRECT_URI is always allowed
OIDC_ALLOWED_REDIRECT_URIS=
OIDC_SCOPES=openid email profile
# Only trust the e-mail claim for admin rights when the provider marks it verified
OIDC_REQUIRE_EMAIL_VERIFIED=true
# Admin allowlists (comma separated). OIDC "sub" is the robust choice; e-mail needs email_verified.
ADMIN_SUBS=
ADMIN_EMAILS=

# --- Labels ----------------------------------------------------------------------------------
# Room label set (lowercase [a-z0-9_]). Order = button order / keyboard shortcuts 1..n
ROOM_LABELS=bad,kueche,wohnzimmer,schlafzimmer,flur,unklar

# --- Sampling (active learning) --------------------------------------------------------------
SAMPLING_STRATEGY=margin
SAMPLING_POOL_SIZE=40

# --- Storage (local paths; in Docker these are set by the image/compose) ------------------------
DATABASE_URL=sqlite:///./var/db/labeling.db
IMAGES_DIR=./var/images
IMAGES_IN_DIR=./images_in
VIDEOS_IN_DIR=./videos_in
EMBED_CACHE_DIR=./var/embed_cache
MODELS_DIR=./var/models
EXPORT_DIR=./var/exports

# --- Ingestion ------------------------------------------------------------------------------
VIDEO_FPS=1.0
FRAME_MAX_SIDE=1280
MAX_IMAGE_BYTES=26214400
MAX_VIDEO_BYTES=8589934592
FFMPEG_BIN=ffmpeg

# --- Model (needs the "siglip" extra) ------------------------------------------------------------
SIGLIP_MODEL=google/siglip-base-patch16-224
# Pin a Hugging Face commit hash for reproducible embeddings (recommended)
SIGLIP_REVISION=

# --- Export ---------------------------------------------------------------------------------
# Salt for pseudonymised labeler ids in the datapack (falls back to SECRET_KEY). Keep stable!
EXPORT_SALT=
